{
  "name": "monrad-estimator",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "postinstall": "node scripts/postinstall.mjs",
    "install:chrome": "node scripts/install-chrome.mjs",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server",
    "test": "npm test --workspace=server && npm test --workspace=client",
    "validate": "npm run lint && npm run typecheck && npm run build && npm test",
    "test:e2e": "npm run test --workspace=e2e",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:e2e:headed": "npm run test:headed --workspace=e2e",
    "test:e2e:report": "npm run report --workspace=e2e",
    "screenshots": "npm run screenshots --workspace=e2e",
    "db:backup": "node scripts/db-backup.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "ip-address": "^10.1.0"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.13",
    "@tailwindcss/oxide-win32-x64-msvc": "4.2.1",
    "lightningcss-win32-x64-msvc": "1.31.1"
  }
}
