{
  "name": "monrad-estimator",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "postinstall": "node scripts/postinstall.mjs",
    "install:chrome": "node scripts/install-chrome.mjs",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "lint": "npm run lint --workspace=client && npm run lint --workspace=server",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server",
    "test": "npm run test:backup && npm run test:local-db && npm test --workspace=server && npm test --workspace=client",
    "validate": "npm run lint && npm run typecheck && npm run build && npm test",
    "test:e2e": "npm run test --workspace=e2e",
    "test:e2e:local": "node scripts/run-e2e-local.mjs",
    "test:e2e:headed": "npm run test:headed --workspace=e2e",
    "test:e2e:report": "npm run report --workspace=e2e",
    "screenshots": "npm run screenshots --workspace=e2e",
    "db:setup": "node scripts/db-setup.mjs",
    "test:integration:local": "node scripts/run-integration-local.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "test:backup": "node --test scripts/db-backup.test.mjs",
    "test:local-db": "node --test scripts/local-postgres.test.mjs scripts/runner-lifecycle.test.mjs scripts/runner-monitoring.test.mjs scripts/aggregated-error.test.mjs scripts/db-setup.test.mjs",
    "test:pdf-cleanup": "node --import tsx --test server/src/test/pdf-cleanup.test.mjs",
    "test:pdf-smoke": "node --import tsx --test server/src/test/pdf-smoke.test.mjs",
    "test:install-chrome": "node --test scripts/install-chrome-lifecycle.test.mjs",
    "capacity-profiles:audit": "npm run capacity-profiles:audit --workspace=server",
    "capacity-profiles:audit:json": "npm run capacity-profiles:audit:json --workspace=server",
    "capacity-profiles:audit:repair": "npm run capacity-profiles:audit:repair --workspace=server",
    "capacity-profiles:readiness": "npm run capacity-profiles:readiness --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "ip-address": "^10.2.0"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.28.1",
    "@rolldown/binding-win32-x64-msvc": "1.1.5",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.2",
    "lightningcss-win32-x64-msvc": "1.32.0"
  },
  "engines": {
    "node": ">=24"
  }
}
