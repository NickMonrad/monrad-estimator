DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monrad_estimator"
# Shell variables override this file. `npm run db:setup` creates this development
# database only when missing; it never resets or drops it.
# JWT signing secret — this dev-only value (32+ chars) works for local dev;
# REPLACE with a secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET="local-dev-jwt-secret-at-least-32-chars!!"
PORT=3001
CLIENT_URL="http://localhost:5173"
# Email (SMTP) — leave blank in dev to log emails to console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Monrad Estimator <noreply@monrad.app>

# Optional externally managed database for disposable local integration/E2E tests.
# Both variables are required because migrations, seed, and cleanup are destructive.
# MONRAD_TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monrad_test_external"
# MONRAD_ALLOW_EXTERNAL_TEST_DATABASE=1
